PORT=3000

# Telegram Bot (отримати у @BotFather)
BOT_TOKEN=7xxxxxxxxxx:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL де задеплоєний фронтенд (Railway дає автоматично)
WEBAPP_URL=https://your-app.up.railway.app

# Секретний ключ для адмін-ендпоінтів
ADMIN_KEY=my-secret-admin-key

# Claude AI для інтерпретацій (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-...

# PostgreSQL (Railway підставляє автоматично якщо додати PostgreSQL-сервіс)
# DATABASE_URL=postgresql://user:pass@host:5432/db
